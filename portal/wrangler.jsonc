// Cloudflare settings for the portal. See README.md in this folder.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open-a11y-portal",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-a11y-portal",
      // No database id here: Cloudflare creates the database the first time you
      // publish, and keeps using it after that.
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Who emails come from. Without your own domain verified in Resend, emails from
    // onboarding@resend.dev only reach your own Resend account's address.
    "EMAIL_FROM": "Accessibility reports <onboarding@resend.dev>",
    // Times in the portal and emails are shown in this time zone.
    "TIME_ZONE": "America/New_York"
  }
  // Private settings are never written here. They're listed in .dev.vars.example:
  // ADMIN_EMAILS, HASH_SALT and RESEND_API_KEY.
}
