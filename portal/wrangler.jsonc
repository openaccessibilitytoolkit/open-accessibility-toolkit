// Cloudflare settings for the portal. See README.md in this folder.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open-a11y-portal",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Cloudflare's browser, for "Check my website" (free plan: 10 minutes a day).
  "browser": { "binding": "BROWSER" },
  // Hands axe-core (the checker) to that browser as plain text.
  "rules": [{ "type": "Text", "globs": ["**/axe.min.js"], "fallthrough": true }],
  // Every day at 13:00 UTC (about 9am US Eastern). The portal sends the monthly
  // statement review reminder on the first of these days in each month.
  "triggers": { "crons": ["0 13 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-a11y-portal",
      // No database id here: Cloudflare creates the database the first time you
      // publish, and keeps using it after that.
      "migrations_dir": "migrations"
    }
  ]
  // All settings are private settings (secrets), listed with explanations in
  // .dev.vars.example. Change them in Cloudflare: your Worker, then Settings, then
  // Variables and Secrets. Updates to the portal never overwrite them.
}
